DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False

# Temporary HTTP access by IP. Replace both values when a domain is available.
ALLOWED_HOSTS=SERVER_IPV4
CSRF_TRUSTED_ORIGINS=http://SERVER_IPV4:8025

# Gunicorn is reachable only from Nginx on the VPS loopback interface.
PAMI_APP_PORT=8026
PAMI_STATIC_PATH=/opt/pami-data/static
PAMI_MEDIA_PATH=/opt/pami-data/media

POSTGRES_VERSION=17-alpine
DB_NAME=pami
DB_USER=pami_user
DB_PASSWORD=replace-with-a-long-random-value
DB_HOST=db
DB_PORT=5432

TIME_ZONE=America/Guayaquil

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Pámi <no-reply@localhost>
CONTACT_NOTIFICATION_EMAIL=
CONTACT_DUPLICATE_WINDOW_SECONDS=60

# Configure these values when a real SMTP provider is available.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Keep these values while the portal is accessed by IP over HTTP.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
